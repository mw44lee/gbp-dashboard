# Copy this file to .env and fill in real values.

# SQLite file, relative to backend/
DATABASE_URL="file:./dev.db"

# Optional. Without this, translation and AI reply drafts fall back to
# clearly-labeled mock text so the app still runs end-to-end.
ANTHROPIC_API_KEY=

# Optional. Google Cloud API key with "Places API (New)" enabled and billing on.
# Used only by `npm run reviews:sync` to pull real reviews. Restrict the key to
# that one API in the Cloud Console.
GOOGLE_PLACES_API_KEY=

PORT=4000
